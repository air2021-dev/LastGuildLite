{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "rootDir": "./src",
    "outDir": "./dist/js",
    "allowJs": false,
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
